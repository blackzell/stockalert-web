# Copie ce fichier en .env (ignoré par git) et remplis les valeurs.
# Ne commite JAMAIS le fichier .env.

# Serveur 1 (utilisateur ubuntu) : deploy.js, deploy.py, install_supabase.js, upload_supabase.js...
UBUNTU_SSH_HOST=
UBUNTU_SSH_USER=ubuntu
# Clé SSH recommandée ; si UBUNTU_SSH_KEY_PATH est vide, le mot de passe est utilisé
UBUNTU_SSH_KEY_PATH=
UBUNTU_SSH_PASSWORD=

# Serveur 2 (utilisateur root) : deploy_server.js, setup_supabase.js, fix_docker_*.js...
ROOT_SSH_HOST=
ROOT_SSH_USER=root
ROOT_SSH_KEY_PATH=
ROOT_SSH_PASSWORD=

# Supabase auto-hébergé (injecté dans supabase/docker/.env sur le serveur)
SUPABASE_POSTGRES_PASSWORD=
SUPABASE_JWT_SECRET=
SUPABASE_DASHBOARD_PASSWORD=
